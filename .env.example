# Copy to .env and fill in. Restart `npm run dev` after any change.

# Base URL of the RouteSafe backend, no trailing slash. e.g. http://192.168.1.20:8000
VITE_API_BASE_URL=

# The contract does not name the endpoints. Put the paths your backend uses (start with "/").
VITE_REPORT_PATH=
VITE_ROUTE_PATH=

# Value sent as "reported_by". Contract example is "user_3tap".
VITE_REPORTED_BY=user_3tap

# true = use src/services/mockApi.js (dummy Nalanchira demo data) instead of the backend.
# false = real API. Also shows/hides the dev scenario picker on the Travel screen.
VITE_USE_MOCK_API=false

# Destination search uses OpenStreetMap Nominatim (not your backend). Set false to disable.
VITE_ENABLE_GEOCODER=true

# true = pin the app to the single Nalanchira demo scenario (Mar Aprem Hostel to Nalanchira
# Main Gate): no GPS prompt on the Travel screen, no destination search, route drawn on open.
# false = real product behaviour: GPS origin + destination search.
VITE_DEMO_MODE=true
